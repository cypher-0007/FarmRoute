# Secrets: keep every real environment file, key, certificate, and service account
# out of Git. Commit only the redacted example files.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
service-account*.json
firebase-adminsdk-*.json

