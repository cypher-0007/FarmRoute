# Firebase browser configuration for the future Vite/React client. These are
# public identifiers, but the Firebase API key must be restricted by domain.
VITE_FIREBASE_API_KEY=replace_with_your_firebase_browser_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=replace_with_your_sender_id
VITE_FIREBASE_APP_ID=replace_with_your_app_id
VITE_FIREBASE_MEASUREMENT_ID=replace_with_your_measurement_id

# Server-only secrets. Set these in your hosting provider's encrypted
# environment-variable settings; never place real values in this file.
GEMINI_API_KEY=replace_with_your_gemini_key
IMGBB_API_KEY=replace_with_your_imgbb_key

# Phone/password login API. Keep the service account JSON private and set it
# only in Vercel's encrypted environment variables (and local .env.local).
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-project-id","private_key_id":"replace_me","private_key":"-----BEGIN PRIVATE KEY-----\\nreplace_me\\n-----END PRIVATE KEY-----\\n","client_email":"firebase-adminsdk@your-project-id.iam.gserviceaccount.com","client_id":"replace_me","token_uri":"https://oauth2.googleapis.com/token"}
FIREBASE_WEB_API_KEY=replace_with_your_firebase_browser_key

# Comma-separated origins allowed to call the image-upload endpoint.
# Include each production and preview URL you intentionally use.
ALLOWED_ORIGINS=https://your-domain.example
